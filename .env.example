# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/resume_rag

# API Keys - Get your own from the services below
OPENAI_API_KEY=sk-proj-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Search Configuration
SIMILARITY_THRESHOLD=0.7
DEFAULT_TOP_K=5
MAX_TOP_K=20

# Generation Configuration
GENERATION_MODEL=claude-opus-4-7
CONTEXT_CHUNK_COUNT=10
MAX_GENERATION_TOKENS=2000
